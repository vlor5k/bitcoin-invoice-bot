generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TransactionStatus {
  PENDING // payor has not broadcasted a valid transaction yet
  CONFIRMING // transaction has been spotted in mempool, but not mined yet
  CONFIRMED // transaction has been mined into a block
}

model Transaction {
  id          Int               @id @default(autoincrement())
  derivation  Int               @unique // m/84'/0'/0'/0/{derivation}
  address     String            @unique
  label       String?
  amount_sats Int
  status      TransactionStatus
  created     DateTime          @default(now())
  txid        String?           // fill out once confirmed
}
